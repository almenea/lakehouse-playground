# ============================================================
# Lakehouse Playground — Shared Environment Variables
# ============================================================

# --- SeaweedFS S3 Credentials ---
S3_ACCESS_KEY=lakehouse-admin
S3_SECRET_KEY=lakehouse-secret-key
S3_REGION=us-east-1
S3_ENDPOINT=http://seaweedfs:8333

# --- Polaris ---
POLARIS_ADMIN_CREDENTIALS=POLARIS,root,polaris-secret
POLARIS_CLIENT_ID=root
POLARIS_CLIENT_SECRET=polaris-secret